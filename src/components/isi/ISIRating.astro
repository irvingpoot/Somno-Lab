---
interface Props {
    name: string;
    labels: string[];
    ariaLabel: string;
}

const { name, labels, ariaLabel } = Astro.props;
---

<div
    data-isi-item={name}
    role="radiogroup"
    aria-label={ariaLabel}
    class="grid grid-cols-5 gap-1.5 sm:gap-2.5 rounded-2xl transition-colors data-[invalid=true]:bg-red-50/70 data-[invalid=true]:ring-4 data-[invalid=true]:ring-red-50"
>
    {
        labels.map((label, value) => (
            <label class="flex flex-col items-center gap-2 text-center cursor-pointer">
                <input type="radio" name={name} value={value} class="peer sr-only" />
                <span class="w-full h-12 sm:h-14 grid place-items-center rounded-xl border border-slate-200 bg-slate-50 text-lg font-black text-slate-400 transition-all duration-200 hover:border-somno/50 hover:text-somno peer-checked:bg-somno peer-checked:border-somno peer-checked:text-white peer-checked:shadow-lg peer-checked:shadow-somno/30 peer-focus-visible:ring-2 peer-focus-visible:ring-somno peer-focus-visible:ring-offset-2">
                    {value}
                </span>
                <span class="min-h-8 text-[10px] sm:text-xs leading-tight text-slate-400 font-light hyphens-auto wrap-break-word transition-colors peer-checked:text-somno peer-checked:font-semibold" lang="es">
                    {label}
                </span>
            </label>
        ))
    }
</div>