---
---

<div id="stopbang-cuestionario" class="space-y-6">

    <div class="space-y-4" id="preguntas-container">

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="1">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">S</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿Ronca fuerte (tan fuerte que se escucha a través de puertas cerradas o su pareja lo mueve para que deje de roncar)?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p1" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p1" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="2">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">T</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿Se siente con frecuencia cansado, fatigado o somnoliento durante el día (por ejemplo, se ha quedado dormido mientras maneja o habla con alguien)?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p2" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p2" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="3">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">O</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿Alguien lo ha visto dejar de respirar o ahogarse mientras duerme?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p3" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p3" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="4">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">P</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿Tiene o está recibiendo tratamiento para la presión arterial alta?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p4" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p4" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="5">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">B</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-2">
                        ¿Tiene un índice de masa corporal mayor a 35 kg/m²?
                    </p>
                    <button id="btn-abrir-imc" type="button" class="inline-flex items-center gap-1.5 text-xs text-somno font-semibold hover:underline mb-3 transition-opacity hover:opacity-80 cursor-pointer">
                        <i class="fas fa-calculator text-[10px]"></i>
                        ¿No sabe su IMC? Calcúlelo aquí
                    </button>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p5" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p5" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="6">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">A</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿Tiene más de 50 años?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p6" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p6" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="7">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">N</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿La circunferencia de su cuello medida a la altura de la manzana de Adán es igual o mayor de 41 cm si es mujer o de 43 cm si es hombre?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p7" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p7" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="pregunta-card bg-slate-50 rounded-2xl p-5 border border-slate-100 transition-all duration-200" data-pregunta="8">
            <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-xl bg-somno/10 border border-somno/20 flex items-center justify-center text-somno font-black text-sm shrink-0 mt-0.5">G</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-700 leading-snug mb-3">
                        ¿Su género es masculino?
                    </p>
                    <div class="flex gap-3">
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p8" value="si" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">Sí</span>
                        </label>
                        <label class="opcion-btn flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="p8" value="no" class="sr-only" />
                            <span class="opcion-label px-4 py-1.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-600 transition-all duration-200 hover:border-somno/50">No</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <p id="alerta-incompleto" class="hidden text-sm text-red-500 font-semibold text-center">
        Por favor responde todas las preguntas antes de continuar.
    </p>

    <button id="btn-calcular" class="w-full bg-somno hover:bg-somno-dark text-white font-bold py-4 px-6 rounded-2xl flex items-center justify-center gap-3 transition-all duration-300 shadow-md shadow-somno/20 hover:-translate-y-1 hover:shadow-lg hover:shadow-somno/30">
        <i class="fas fa-stethoscope"></i>
        Ver resultado
    </button>

    <div id="resultado-container" class="hidden">
        <div id="resultado-card" class="rounded-3xl p-6 border-2 transition-all duration-500">

            <div class="flex items-start gap-4 mb-4">
                <div id="resultado-icono" class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0">
                    <i id="resultado-icono-i" class="fas text-2xl"></i>
                </div>
                <div>
                    <p id="resultado-etiqueta" class="text-xs font-bold uppercase tracking-widest mb-1"></p>
                    <h3 id="resultado-titulo" class="text-xl font-black text-slate-800 tracking-tight"></h3>
                </div>
            </div>

            <p id="resultado-desc" class="text-sm text-slate-600 leading-relaxed mb-4"></p>

            <div class="mb-5">
                <div class="flex justify-between text-xs text-slate-400 font-semibold mb-1">
                    <span>0</span>
                    <span id="resultado-puntaje-label" class="font-black"></span>
                    <span>8</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                    <div id="resultado-barra" class="h-2.5 rounded-full transition-all duration-700 ease-out" style="width:0%"></div>
                </div>
            </div>

            <div id="resultado-nota" class="mb-4">
                <p class="text-sm text-slate-600 leading-relaxed"></p>
            </div>

            <a id="resultado-cta" href="/servicios#contacto" class="w-full flex items-center justify-center gap-2 font-bold py-3 px-5 rounded-2xl text-sm transition-all duration-300 hover:-translate-y-0.5">
                <i class="fas fa-calendar-check text-sm"></i>
                <span id="resultado-cta-texto"></span>
            </a>

        </div>

        <button id="btn-reiniciar" class="mt-4 w-full border border-slate-200 hover:border-somno/40 text-slate-500 hover:text-somno font-semibold py-3 px-6 rounded-2xl flex items-center justify-center gap-2 transition-all duration-300 text-sm">
            <i class="fas fa-redo text-xs"></i>
            Realizar de nuevo
        </button>
    </div>

<dialog id="modal-imc" class="m-auto rounded-3xl shadow-2xl w-full max-w-sm p-7 border-0 backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm animate-modal-in" aria-labelledby="modal-imc-titulo">

        <div class="flex items-start justify-between mb-5">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-somno">Calculadora</span>
                <h2 id="modal-imc-titulo" class="text-xl font-black text-slate-800 tracking-tight mt-0.5">Índice de Masa Corporal</h2>
            </div>
            <button id="btn-cerrar-imc" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-colors shrink-0 ml-3">
                <i class="fas fa-xmark text-sm"></i>
            </button>
        </div>

        <div class="space-y-4 mb-5">
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Peso</label>
                <div class="flex gap-2">
                    <input
                        id="imc-peso"
                        type="number"
                        min="20" max="300"
                        placeholder="Ej. 80"
                        class="flex-1 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-700 font-semibold focus:outline-none focus:border-somno focus:ring-2 focus:ring-somno/20 transition"
                    />
                    <span class="flex items-center px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-400">kg</span>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Estatura</label>
                <div class="flex gap-2">
                    <input
                        id="imc-altura"
                        type="number"
                        min="100" max="250"
                        placeholder="Ej. 170"
                        class="flex-1 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-700 font-semibold focus:outline-none focus:border-somno focus:ring-2 focus:ring-somno/20 transition"
                    />
                    <span class="flex items-center px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-400">cm</span>
                </div>
            </div>
        </div>

        <button id="btn-calcular-imc" class="w-full bg-somno hover:bg-somno-dark text-white font-bold py-3 px-5 rounded-2xl text-sm flex items-center justify-center gap-2 transition-all duration-300 hover:-translate-y-0.5 shadow-md shadow-somno/20 mb-4">
            <i class="fas fa-calculator text-xs"></i>
            Calcular IMC
        </button>

        <div id="imc-resultado" class="hidden rounded-2xl p-4 text-center">
            <p class="text-xs font-bold uppercase tracking-widest mb-1" id="imc-resultado-cat"></p>
            <p class="text-4xl font-black tracking-tighter mb-1" id="imc-resultado-valor"></p>
            <p class="text-xs text-slate-400 mb-3">kg/m²</p>
            <div id="imc-barra-container" class="w-full bg-slate-100 rounded-full h-2 overflow-hidden mb-3">
                <div id="imc-barra" class="h-2 rounded-full transition-all duration-700 ease-out" style="width:0%"></div>
            </div>
            <p id="imc-resultado-msg" class="text-xs text-slate-500 leading-relaxed"></p>
        </div>

        <p id="imc-error" class="hidden text-xs text-red-500 font-semibold text-center mt-1">
            Por favor ingresa valores válidos de peso y estatura.
        </p>

</dialog>

</div>

<style>
    .opcion-label {
        cursor: pointer;
        user-select: none;
    }

    input[type="radio"]:checked + .opcion-label {
        background-color: var(--color-somno, #6366f1);
        color: #fff;
        border-color: var(--color-somno, #6366f1);
        box-shadow: 0 2px 10px -2px color-mix(in srgb, var(--color-somno, #6366f1) 40%, transparent);
    }

    .pregunta-card.respondida {
        border-color: color-mix(in srgb, var(--color-somno, #6366f1) 30%, transparent);
    }

    .pregunta-card.sin-responder {
        border-color: #f87171;
        background-color: #fff5f5;
    }

    @keyframes modalIn {
        from { opacity: 0; transform: translateY(16px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-modal-in {
        animation: modalIn 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnCalcular  = document.getElementById('btn-calcular')!;
        const btnReiniciar = document.getElementById('btn-reiniciar')!;
        const alerta       = document.getElementById('alerta-incompleto')!;
        const resultadoContainer = document.getElementById('resultado-container')!;
        const cards = document.querySelectorAll<HTMLElement>('.pregunta-card');

        cards.forEach(card => {
            const inputs = card.querySelectorAll<HTMLInputElement>('input[type="radio"]');
            inputs.forEach(input => {
                input.addEventListener('change', () => {
                    card.classList.remove('sin-responder');
                    card.classList.add('respondida');
                });
            });
        });

        btnCalcular.addEventListener('click', () => {
            const preguntas = ['p1','p2','p3','p4','p5','p6','p7','p8'];
            let todasRespondidas = true;

            cards.forEach(card => card.classList.remove('sin-responder'));

            preguntas.forEach((nombre, i) => {
                const seleccionado = document.querySelector<HTMLInputElement>(`input[name="${nombre}"]:checked`);
                if (!seleccionado) {
                    todasRespondidas = false;
                    cards[i]?.classList.add('sin-responder');
                }
            });

            if (!todasRespondidas) {
                alerta.classList.remove('hidden');
                cards[0].closest('section')?.querySelector('.sin-responder')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            alerta.classList.add('hidden');

            const respuestas: number[] = preguntas.map(n =>
                (document.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value === 'si') ? 1 : 0
            );
            const puntaje = respuestas.reduce((a, b) => a + b, 0);

            const primeraCuatro = respuestas.slice(0, 4).reduce((a, b) => a + b, 0);
            const esMasculino   = respuestas[7] === 1;
            const imcAlto       = respuestas[4] === 1;
            const cuelloGrande  = respuestas[6] === 1;

            const altoRiesgoExtendido =
                puntaje >= 5 ||
                (primeraCuatro >= 2 && esMasculino) ||
                (primeraCuatro >= 2 && imcAlto) ||
                (primeraCuatro >= 2 && cuelloGrande);

            mostrarResultado(puntaje, altoRiesgoExtendido);
        });

        btnReiniciar.addEventListener('click', () => {
            document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(r => r.checked = false);
            cards.forEach(c => c.classList.remove('respondida', 'sin-responder'));
            resultadoContainer.classList.add('hidden');
            alerta.classList.add('hidden');
            btnCalcular.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        function mostrarResultado(puntaje: number, altoRiesgoExtendido: boolean) {
            const card       = document.getElementById('resultado-card')!;
            const icono      = document.getElementById('resultado-icono')!;
            const iconoI     = document.getElementById('resultado-icono-i')!;
            const etiqueta   = document.getElementById('resultado-etiqueta')!;
            const titulo     = document.getElementById('resultado-titulo')!;
            const desc       = document.getElementById('resultado-desc')!;
            const barra      = document.getElementById('resultado-barra')!;
            const puntajeLabel = document.getElementById('resultado-puntaje-label')!;
            const notaEl     = document.getElementById('resultado-nota')!;

            type Nivel = { color: string; bg: string; icono: string; etiqueta: string; titulo: string; desc: string; nota: string; barra: string };
            let nivel: Nivel;

            if (altoRiesgoExtendido) {
                nivel = {
                    color: 'text-red-600',
                    bg: 'bg-red-50 border-red-200',
                    icono: 'bg-red-100 text-red-600',
                    iconoI: 'fa-triangle-exclamation',
                    etiqueta: 'Alto riesgo de AOS',
                    titulo: 'Riesgo elevado de Apnea Obstructiva del Sueño',
                    desc: `Obtuviste ${puntaje} de 8 puntos. Los criterios de calificación indican un alto riesgo de Apnea Obstructiva del Sueño (AOS). Esto puede deberse a 5 o más respuestas afirmativas, o a 2 o más respuestas afirmativas en las primeras 4 preguntas combinadas con género masculino, IMC elevado o circunferencia de cuello aumentada.`,
                    nota: 'Te recomendamos agendar una consulta con nuestros especialistas a la brevedad posible. La apnea del sueño no tratada puede tener consecuencias cardiovasculares y metabólicas importantes, y un estudio del sueño puede confirmar el diagnóstico e iniciar el tratamiento adecuado.',
                    barra: 'bg-red-500',
                    ctaClase: 'bg-red-600 hover:bg-red-700 text-white shadow-md shadow-red-200',
                    ctaTexto: 'Agendar consulta urgente',
                } as any;
            } else if (puntaje >= 3) {
                nivel = {
                    color: 'text-amber-600',
                    bg: 'bg-amber-50 border-amber-200',
                    icono: 'bg-amber-100 text-amber-600',
                    iconoI: 'fa-circle-exclamation',
                    etiqueta: 'Riesgo intermedio de AOS',
                    titulo: 'Riesgo intermedio de Apnea Obstructiva del Sueño',
                    desc: `Obtuviste ${puntaje} de 8 puntos. Tu puntaje se encuentra en el rango de riesgo intermedio para Apnea Obstructiva del Sueño (AOS): entre 3 y 4 respuestas afirmativas.`,
                    nota: 'Te recomendamos agendar una consulta con nuestros especialistas para que un médico evalúe estos resultados. Una valoración del sueño puede ayudar a descartar o confirmar la presencia de apnea y orientarte sobre los siguientes pasos.',
                    barra: 'bg-amber-400',
                    ctaClase: 'bg-amber-500 hover:bg-amber-600 text-white shadow-md shadow-amber-200',
                    ctaTexto: 'Agendar consulta',
                } as any;
            } else {
                nivel = {
                    color: 'text-emerald-600',
                    bg: 'bg-emerald-50 border-emerald-200',
                    icono: 'bg-emerald-100 text-emerald-600',
                    iconoI: 'fa-circle-check',
                    etiqueta: 'Bajo riesgo de AOS',
                    titulo: 'Bajo riesgo de Apnea Obstructiva del Sueño',
                    desc: `Obtuviste ${puntaje} de 8 puntos. Tu puntaje indica un bajo riesgo de Apnea Obstructiva del Sueño (AOS): entre 0 y 2 respuestas afirmativas.`,
                    nota: 'Aunque el riesgo es bajo, si presentas síntomas persistentes de somnolencia o mala calidad del sueño, te invitamos a agendar una consulta. Nuestros especialistas pueden ayudarte a mejorar tu descanso y descartar otras causas.',
                    barra: 'bg-emerald-500',
                    ctaClase: 'border border-emerald-300 text-emerald-700 hover:bg-emerald-50',
                    ctaTexto: 'Agendar una consulta',
                } as any;
            }

            card.className = `rounded-3xl p-6 border-2 transition-all duration-500 ${nivel.bg}`;
            icono.className = `w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${(nivel as any).icono}`;
            iconoI.className = `fas ${(nivel as any).iconoI} text-2xl`;
            etiqueta.className = `text-xs font-bold uppercase tracking-widest mb-1 ${nivel.color}`;
            etiqueta.textContent = nivel.etiqueta;
            titulo.textContent = nivel.titulo;
            desc.textContent = nivel.desc;
            barra.className = `h-2.5 rounded-full transition-all duration-700 ease-out ${nivel.barra}`;
            puntajeLabel.textContent = `${puntaje} / 8`;
            notaEl.querySelector('p')!.textContent = nivel.nota;

            const cta = document.getElementById('resultado-cta')!;
            const ctaTexto = document.getElementById('resultado-cta-texto')!;
            cta.className = `w-full flex items-center justify-center gap-2 font-bold py-3 px-5 rounded-2xl text-sm transition-all duration-300 hover:-translate-y-0.5 ${(nivel as any).ctaClase}`;
            ctaTexto.textContent = (nivel as any).ctaTexto;

            requestAnimationFrame(() => {
                barra.style.width = `${(puntaje / 8) * 100}%`;
            });

            resultadoContainer.classList.remove('hidden');
            btnCalcular.classList.add('hidden');

            setTimeout(() => {
                resultadoContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }

        const modalImc      = document.getElementById('modal-imc') as HTMLDialogElement;
        const btnAbrirImc   = document.getElementById('btn-abrir-imc')!;
        const btnCerrarImc  = document.getElementById('btn-cerrar-imc')!;
        const btnCalcImc    = document.getElementById('btn-calcular-imc')!;
        const inputPeso     = document.getElementById('imc-peso') as HTMLInputElement;
        const inputAltura   = document.getElementById('imc-altura') as HTMLInputElement;
        const imcResultado  = document.getElementById('imc-resultado')!;
        const imcCat        = document.getElementById('imc-resultado-cat')!;
        const imcValor      = document.getElementById('imc-resultado-valor')!;
        const imcMsg        = document.getElementById('imc-resultado-msg')!;
        const imcBarra      = document.getElementById('imc-barra')!;
        const imcError      = document.getElementById('imc-error')!;

        btnAbrirImc.addEventListener('click', () => {
            modalImc.showModal();
            inputPeso.focus();
        });

        btnCerrarImc.addEventListener('click', () => modalImc.close());

        modalImc.addEventListener('click', (e) => {
            if (e.target === modalImc) modalImc.close();
        });

        btnCalcImc.addEventListener('click', () => {
            const peso   = parseFloat(inputPeso.value);
            const altura = parseFloat(inputAltura.value);

            if (!peso || !altura || peso < 20 || peso > 300 || altura < 100 || altura > 250) {
                imcError.classList.remove('hidden');
                imcResultado.classList.add('hidden');
                return;
            }

            imcError.classList.add('hidden');

            const alturaM = altura / 100;
            const imc = peso / (alturaM * alturaM);
            const imcRedondeado = Math.round(imc * 10) / 10;

            type CatInfo = { cat: string; color: string; barra: string; pct: number; msg: string; bg: string };
            let info: CatInfo;

            if (imc < 18.5) {
                info = { cat: 'Bajo peso', color: 'text-blue-600', barra: 'bg-blue-400', pct: 15, bg: 'bg-blue-50',
                    msg: 'Tu IMC está por debajo del rango normal. Para la pregunta del cuestionario, responde No.' };
            } else if (imc < 25) {
                info = { cat: 'Peso normal', color: 'text-emerald-600', barra: 'bg-emerald-400', pct: 35, bg: 'bg-emerald-50',
                    msg: 'Tu IMC está en el rango normal. Para la pregunta del cuestionario, responde No.' };
            } else if (imc < 30) {
                info = { cat: 'Sobrepeso', color: 'text-amber-600', barra: 'bg-amber-400', pct: 55, bg: 'bg-amber-50',
                    msg: 'Tu IMC indica sobrepeso, pero es menor a 35. Para la pregunta del cuestionario, responde No.' };
            } else if (imc < 35) {
                info = { cat: 'Obesidad grado I', color: 'text-orange-600', barra: 'bg-orange-400', pct: 72, bg: 'bg-orange-50',
                    msg: 'Tu IMC indica obesidad grado I, pero es menor a 35. Para la pregunta del cuestionario, responde No.' };
            } else {
                info = { cat: imc < 40 ? 'Obesidad grado II' : 'Obesidad grado III', color: 'text-red-600', barra: 'bg-red-500', pct: Math.min(92, 80 + (imc - 35) * 2), bg: 'bg-red-50',
                    msg: 'Tu IMC es mayor a 35. Para la pregunta del cuestionario, responde Sí.' };
            }

            imcResultado.className = `rounded-2xl p-4 text-center ${info.bg}`;
            imcCat.className = `text-xs font-bold uppercase tracking-widest mb-1 ${info.color}`;
            imcCat.textContent = info.cat;
            imcValor.className = `text-4xl font-black tracking-tighter mb-1 ${info.color}`;
            imcValor.textContent = String(imcRedondeado);
            imcMsg.textContent = info.msg;

            imcBarra.className = `h-2 rounded-full transition-all duration-700 ease-out ${info.barra}`;
            imcBarra.style.width = '0%';
            requestAnimationFrame(() => {
                imcBarra.style.width = `${info.pct}%`;
            });

            imcResultado.classList.remove('hidden');
        });

        [inputPeso, inputAltura].forEach(input => {
            input.addEventListener('input', () => {
                imcResultado.classList.add('hidden');
                imcError.classList.add('hidden');
            });
        });
    });
</script>