---
interface Props {
    name: string;
    number: number;
    text: string;
    compact?: boolean;
}

const { name, number, text, compact = false } = Astro.props;
const labelId = `lbl-${name}`;
---

<div class="py-6 first:pt-0 border-t border-slate-100 first:border-t-0">
    <div class:list={['flex gap-4', compact ? 'flex-col sm:flex-row sm:items-center sm:justify-between' : 'flex-col']}>
        <div class="flex items-start gap-4 min-w-0">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-somno/10 border border-somno/20 text-somno-dark grid place-items-center font-black text-base tabular-nums">
                {number}
            </span>
            <p id={labelId} class:list={['pt-1.5 text-slate-800 tracking-tight leading-snug', compact ? 'text-base font-semibold' : 'text-base sm:text-lg font-bold']}>
                {text}
            </p>
        </div>

        <div
            data-item={name}
            role="radiogroup"
            aria-labelledby={labelId}
            class:list={[
                'grid grid-cols-2 gap-2.5 rounded-2xl transition-colors data-[invalid=true]:bg-red-50/70 data-[invalid=true]:ring-4 data-[invalid=true]:ring-red-50',
                compact ? 'w-full sm:w-44 pl-14 sm:pl-0 shrink-0' : 'max-w-xs ml-14',
            ]}
        >
            {
                [
                    { value: 'si', label: 'Sí' },
                    { value: 'no', label: 'No' },
                ].map((opt) => (
                    <label class="cursor-pointer">
                        <input type="radio" name={name} value={opt.value} class="peer sr-only" />
                        <span class="w-full h-11 grid place-items-center rounded-xl border border-slate-200 bg-slate-50 text-base font-black text-slate-400 transition-all duration-200 hover:border-somno/50 hover:text-somno peer-checked:bg-somno peer-checked:border-somno peer-checked:text-white peer-checked:shadow-lg peer-checked:shadow-somno/30 peer-focus-visible:ring-2 peer-focus-visible:ring-somno peer-focus-visible:ring-offset-2">
                            {opt.label}
                        </span>
                    </label>
                ))
            }
        </div>
    </div>
</div>