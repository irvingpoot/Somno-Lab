---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

type Etiqueta = 'Plantilla descargable' | 'Herramienta interactiva' | 'Cuestionario de evaluación';

type Herramienta = {
    slug: string;
    titulo: string;
    descripcion: string;
    icono: string;
    etiqueta: Etiqueta;
    meta?: string;
};

const herramientas: Herramienta[] = [
    {
        slug: '/herramientas/habitos-sueno',
        titulo: 'Hábitos para mejorar mi sueño',
        descripcion: 'Registra y da seguimiento a tus hábitos de sueño durante cuatro semanas. Imprimible y fácil de usar.',
        icono: 'fa-moon',
        etiqueta: 'Plantilla descargable',
    },
    {
        slug: '/herramientas/diario-sueno',
        titulo: 'Diario de sueño clínico',
        descripcion: 'Registra de manera precisa tus horas de sueño, despertares y hábitos diarios con nomenclatura especializada.',
        icono: 'fa-book-medical',
        etiqueta: 'Plantilla descargable',
    },
    {
        slug: '/#calculadora',
        titulo: 'Semáforo de sueño',
        descripcion: 'Calculadora de sueño para conocer tu hora de descanso adecuada.',
        icono: 'fa-calculator',
        etiqueta: 'Herramienta interactiva',
    },
    {
        slug: '/cronograma',
        titulo: 'Cronograma de sueño',
        descripcion: 'Ajuste su reloj biológico paso a paso.',
        icono: 'fa-clock',
        etiqueta: 'Herramienta interactiva',
    },
    {
        slug: '/herramientas/stop-bang',
        titulo: 'Cuestionario STOP-BANG',
        descripcion: 'Evalúa tu riesgo de Apnea Obstructiva del Sueño respondiendo 8 preguntas clínicas validadas. Obtén tu resultado al instante.',
        icono: 'fa-stethoscope',
        etiqueta: 'Cuestionario de evaluación',
        meta: '8 preguntas',
    },
    {
        slug: '/herramientas/isi',
        titulo: 'Índice de Gravedad del Insomnio (ISI)',
        descripcion: 'Evalúa la gravedad de tu insomnio respondiendo 7 preguntas clínicas validadas. Obtén tu resultado al instante.',
        icono: 'fa-bed',
        etiqueta: 'Cuestionario de evaluación',
        meta: '7 preguntas',
    },
    {
        slug: '/herramientas/insomnio',
        titulo: 'Cuestionario de Insomnio',
        descripcion: 'Evalúa tu riesgo de insomnio respondiendo 13 preguntas clínicas validadas. Obtén tu resultado al instante.',
        icono: 'fa-moon',
        etiqueta: 'Cuestionario de evaluación',
        meta: '13 preguntas',
    },
];

const iconoEtiqueta: Record<Etiqueta | 'Todas', string> = {
    Todas: 'fa-table-cells-large',
    'Plantilla descargable': 'fa-file-arrow-down',
    'Herramienta interactiva': 'fa-sliders',
    'Cuestionario de evaluación': 'fa-clipboard-list',
};

const etiquetas = ['Todas', ...new Set(herramientas.map((h) => h.etiqueta))] as (Etiqueta | 'Todas')[];
const conteo = (e: string) => (e === 'Todas' ? herramientas.length : herramientas.filter((h) => h.etiqueta === e).length);
---

<Layout title="Herramientas | SomnoLab">
    <Navbar />

    <section class="relative min-h-dvh bg-slate-50 pt-32 pb-24 overflow-x-clip">

        <div class="absolute top-[-5%] right-[-5%] w-96 h-96 bg-somno-light/20 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute bottom-[-5%] left-[-10%] w-120 h-120 bg-somno/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <div class="text-center mb-12 space-y-4 animate-fade-in-up">
                <span class="inline-block text-somno font-bold tracking-wider uppercase text-sm">
                    Recursos gratuitos
                </span>
                <h1 class="text-5xl sm:text-6xl font-black tracking-tighter text-slate-900 leading-[1.1]">
                    Herramientas para<br/>
                    <span class="text-transparent bg-clip-text bg-linear-to-r from-somno-dark via-somno to-somno-light">
                        mejorar tu sueño
                    </span>
                </h1>
                <p class="text-xl text-slate-600 max-w-2xl mx-auto font-light leading-relaxed">
                    Recursos diseñados por nuestros especialistas para que puedas trabajar en tu descanso desde casa.
                </p>
            </div>

            <div class="flex justify-center mb-10 animate-fade-in-up" style="animation-delay:0.15s; opacity:0; animation-fill-mode:forwards;">
                <div
                    id="filtro-track"
                    role="group"
                    aria-label="Filtrar herramientas por tipo"
                    class="no-scrollbar relative flex max-w-full gap-1 overflow-x-auto rounded-full border border-slate-200 bg-white p-1.5 shadow-sm"
                >
                    <span
                        id="filtro-indicador"
                        aria-hidden="true"
                        class="absolute left-0 top-1.5 bottom-1.5 w-0 rounded-full bg-linear-to-r from-somno to-somno-light shadow-md shadow-somno/30 transition-[transform,width] duration-300 ease-out"
                    ></span>

                    {
                        etiquetas.map((etiqueta) => (
                            <button
                                type="button"
                                data-filtro={etiqueta}
                                aria-pressed={etiqueta === 'Todas' ? 'true' : 'false'}
                                class="filtro-btn relative z-10 inline-flex shrink-0 cursor-pointer select-none items-center gap-2 whitespace-nowrap rounded-full px-4 py-2.5 text-sm font-semibold text-slate-500 transition-colors duration-300 hover:text-somno-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-somno aria-pressed:text-white aria-pressed:hover:text-white"
                            >
                                <i class={`fas ${iconoEtiqueta[etiqueta]} text-xs`}></i>
                                {etiqueta}
                                <span class="filtro-conteo grid min-w-5 place-items-center rounded-full bg-somno/10 px-1.5 py-0.5 text-[11px] font-bold leading-none text-somno-dark tabular-nums transition-colors duration-300">
                                    {conteo(etiqueta)}
                                </span>
                            </button>
                        ))
                    }
                </div>
            </div>

            <div id="grid-herramientas" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    herramientas.map((h) => (
                        <a
                            href={h.slug}
                            data-etiqueta={h.etiqueta}
                            class="herramienta-card group relative isolate flex flex-col overflow-hidden rounded-lg border border-slate-200/70 bg-white p-7 shadow-sm hover:-translate-y-1 hover:border-somno/40 hover:shadow-xl hover:shadow-somno/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-somno"
                        >
                            <div class="pointer-events-none absolute -top-20 -right-20 -z-10 h-52 w-52 rounded-full bg-somno-light/25 opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-100"></div>

                            <div class="flex grow flex-col items-start">
                                <h2 class="text-xl font-black leading-snug tracking-tight text-slate-900">{h.titulo}</h2>
                                <p class="mt-2 text-sm font-light leading-relaxed text-slate-500">{h.descripcion}</p>
                                {h.meta && (
                                    <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-slate-400">
                                        <i class="fas fa-list-check text-[10px]"></i>
                                        {h.meta}
                                    </span>
                                )}
                            </div>

                            <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-5 text-sm">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-somno/10 px-2.5 py-1 text-xs font-semibold text-somno-dark">
                                    <i class={`fas ${iconoEtiqueta[h.etiqueta]} text-[10px]`}></i>
                                    {h.etiqueta}
                                </span>
                                <span class="font-bold text-somno">Ver herramienta</span>
                            </div>
                        </a>
                    ))
                }
            </div>

            <p id="contador" aria-live="polite" class="mt-8 text-center text-sm text-slate-400">
                Mostrando <span id="num-visible" class="font-bold text-somno">{herramientas.length}</span> de {herramientas.length} herramientas en total
            </p>

            <div id="estado-vacio" class="hidden flex-col items-center justify-center py-24 gap-4 text-center">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-300">
                    <i class="fas fa-search text-2xl"></i>
                </div>
                <p class="text-slate-400 font-medium">No hay herramientas en esta categoría todavía.</p>
            </div>

        </div>
    </section>
</Layout>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    .filtro-btn[aria-pressed='true'] .filtro-conteo {
        background-color: rgb(255 255 255 / 0.25);
        color: #fff;
    }

    .herramienta-card {
        opacity: 1;
        transition:
            opacity 0.35s ease,
            transform 0.35s ease,
            box-shadow 0.3s ease,
            border-color 0.3s ease;
        will-change: opacity, transform;
    }

    .herramienta-card.saliendo {
        opacity: 0;
        transform: translateY(16px) scale(0.96);
        pointer-events: none;
    }

    @keyframes cardEntrada {
        from { opacity: 0; transform: translateY(24px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0)  scale(1); }
    }
    .herramienta-card.entrando {
        animation: cardEntrada 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-fade-in-up { animation: none; opacity: 1 !important; }
        .herramienta-card { transition: none; }
        .herramienta-card.entrando { animation: none; }
    }
</style>

<script>
    const DURACION_SALIDA = 320;

    document.addEventListener('DOMContentLoaded', () => {
        const track       = document.getElementById('filtro-track')!;
        const indicador   = document.getElementById('filtro-indicador')!;
        const botones     = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
        const tarjetas    = document.querySelectorAll<HTMLElement>('.herramienta-card');
        const numVisible  = document.getElementById('num-visible')!;
        const estadoVacio = document.getElementById('estado-vacio')!;
        const grid        = document.getElementById('grid-herramientas')!;

        const reducirMovimiento = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let filtroActual = 'Todas';

        function moverIndicador(btn: HTMLElement, animar = true) {
            indicador.style.transition = animar && !reducirMovimiento() ? '' : 'none';
            indicador.style.width = `${btn.offsetWidth}px`;
            indicador.style.transform = `translateX(${btn.offsetLeft}px)`;
            btn.scrollIntoView({ inline: 'center', block: 'nearest', behavior: animar && !reducirMovimiento() ? 'smooth' : 'auto' });
        }

        const botonActivo = () =>
            Array.from(botones).find((b) => b.getAttribute('aria-pressed') === 'true')!;

        moverIndicador(botonActivo(), false);
        window.addEventListener('resize', () => moverIndicador(botonActivo(), false));
        document.fonts?.ready.then(() => moverIndicador(botonActivo(), false));

        botones.forEach((btn) => {
            btn.addEventListener('click', () => {
                const filtro = btn.dataset.filtro!;
                if (filtro === filtroActual) return;
                filtroActual = filtro;

                botones.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
                moverIndicador(btn);
                aplicarFiltro(filtro);
            });
        });

        function aplicarFiltro(filtro: string) {
            const visibles: HTMLElement[] = [];
            const ocultas: HTMLElement[] = [];

            tarjetas.forEach((card) => {
                const mostrar = filtro === 'Todas' || card.dataset.etiqueta === filtro;
                (mostrar ? visibles : ocultas).push(card);
            });

            ocultas.forEach((card) => {
                card.classList.remove('entrando');
                card.classList.add('saliendo');
            });

            setTimeout(() => {
                ocultas.forEach((card) => {
                    card.style.display = 'none';
                    card.classList.remove('saliendo');
                });

                visibles.forEach((card, i) => {
                    card.style.display = '';
                    card.classList.remove('saliendo', 'entrando');

                    void card.offsetWidth;

                    card.style.animationDelay = `${i * 60}ms`;
                    card.classList.add('entrando');

                    card.addEventListener(
                        'animationend',
                        () => {
                            card.classList.remove('entrando');
                            card.style.animationDelay = '';
                        },
                        { once: true },
                    );
                });

                numVisible.textContent = String(visibles.length);

                const hayResultados = visibles.length > 0;
                grid.style.display = hayResultados ? '' : 'none';
                estadoVacio.style.display = hayResultados ? 'none' : 'flex';
            }, DURACION_SALIDA);
        }
    });
</script>