---
import Layout from '../../layouts/Layout.astro';
import ReturnButton from '../../components/ReturnButton.astro';
import ISIQuestionnaire from '../../components/isi/ISIQuestionnaire.astro';
import ISIInfoPanel from '../../components/isi/ISIInfoPanel.astro';
import { BANDS } from '../../data/isi';
---

<Layout title="Índice de Gravedad del Insomnio (ISI) | SomnoLab">
    <ReturnButton href="/herramientas" />
    <div class="flex p-5 justify-end">
        <a href="/" class="flex items-center gap-1 group">
            <img src="/IconSomno.webp" alt="SomnoLab Logo" class="h-8 w-auto rounded-lg group-hover:scale-105 transition-transform" />
            <span class="pr-1 font-black tracking-tighter text-2xl bg-clip-text text-transparent bg-linear-to-r from-somno-light to-somno">
                SomnoLab
            </span>
        </a>
    </div>

    <section class="relative min-h-dvh bg-slate-50 pt-6 pb-24 overflow-x-clip">
        <div class="absolute top-[30%] left-[-5%] w-96 h-96 bg-somno-light/20 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute bottom-[20%] right-[-10%] w-120 h-120 bg-somno/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <header class="relative mb-12 overflow-hidden rounded-4xl border border-somno/15 bg-linear-to-br from-white via-somno/5 to-somno-light/25 px-6 py-12 sm:px-12 sm:py-16 lg:py-20 shadow-sm animate-fade-in-up">
                <div class="absolute -top-32 -left-20 w-120 h-120 bg-somno-light/25 rounded-full blur-[130px] pointer-events-none"></div>
                <div class="absolute -bottom-40 right-10 w-96 h-96 bg-somno/15 rounded-full blur-[120px] pointer-events-none"></div>

                <span
                    aria-hidden="true"
                    class="pointer-events-none select-none absolute -right-4 sm:right-8 top-1/2 -translate-y-1/2 text-[9rem] sm:text-[16rem] lg:text-[20rem] font-black tracking-tighter leading-none text-transparent"
                    style="-webkit-text-stroke: 2px color-mix(in srgb, var(--color-somno) 28%, transparent);"
                >
                    ISI
                </span>

                <div class="relative max-w-2xl">
                    <span class="inline-block text-somno font-bold tracking-wider uppercase text-sm mb-3">
                        Cuestionario de evaluación de SomnoLab
                    </span>
                    <h1 class="text-4xl sm:text-6xl font-black tracking-tighter text-slate-900 leading-[1.05] mb-5">
                        Índice de Gravedad del Insomnio
                    </h1>
                    <p class="text-lg text-slate-600 font-light leading-relaxed mb-8">
                        Evalúa qué tanto está afectando el insomnio a tu descanso y a tu día a día. Responde 5 preguntas y recibe tu resultado con una recomendación al instante.
                    </p>
                </div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">

                <div class="lg:col-span-7 xl:col-span-8 animate-fade-in-up" style="animation-delay: 0.1s;">
                    <ISIQuestionnaire />
                </div>

                <aside class="lg:col-span-5 xl:col-span-4 animate-fade-in-up" style="animation-delay: 0.2s;">
                    <ISIInfoPanel />
                </aside>

            </div>
        </div>
    </section>
</Layout>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        opacity: 0;
    }
    @media (prefers-reduced-motion: reduce) {
        .animate-fade-in-up { animation: none; opacity: 1; }
    }
</style>