---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const eventos = [
    {
        slug: "suenos-cortos-2026",
        titulo: "Sueños Cortos 2026",
        categoria: "Festival",
        fecha: "2026-05-18",
        dia: "18",
        mes: "MAY",
        hora: "10:00 hrs",
        lugar: "Facultad de psicología, UADY",
        precio: "Entrada libre",
        descripcion: "Una noche de cine con cortometrajes dedicados a las neurociencias, salud y el sueño",
        img: "/eventos/suenoscortos/suenosCortosIcon.png",
        destacado: true,
        tag_color: "bg-somno",
    },
];

const hoy = new Date();
hoy.setHours(0, 0, 0, 0);

const proximos  = eventos.filter(e => new Date(e.fecha + 'T00:00:00') >= hoy);
const pasados   = eventos.filter(e => new Date(e.fecha + 'T00:00:00') <  hoy);
const destacados = proximos.filter(e => e.destacado);
---

<Layout title="Eventos | SomnoLab">
    <Navbar />

    <main class="bg-slate-50 min-h-screen pt-24 pb-28 overflow-x-hidden">

        <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-14 text-center animate-fade-in-up">
            <span class="inline-block text-somno font-bold uppercase tracking-[0.25em] text-xs mb-4">
                Eventos SomnoLab
            </span>
            <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-slate-900 mb-4 leading-[1.05]">
                Calendario <span class="text-transparent bg-clip-text bg-linear-to-r from-somno-dark via-somno to-somno-light">Oficial</span>
            </h1>
            <p class="text-slate-500 text-lg max-w-xl mx-auto">
                Talleres, webinars, festivales y encuentros para transformar tu relación con el sueño.
            </p>
        </div>

        {destacados.length > 0 && (
            <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-20 animate-fade-in-up" style="animation-delay:0.1s">
                {destacados.map(evento => (
                    <a href={`/eventos/${evento.slug}`} class="group relative flex rounded-[2.5rem] overflow-hidden shadow-2xl h-120 md:h-130 bg-slate-900 cursor-pointer block">

                        <img
                            src={evento.img}
                            alt={evento.titulo}
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-[8s] ease-linear scale-100 group-hover:scale-110"
                        />

                        <div class="absolute inset-0 bg-linear-to-r from-slate-900/90 via-slate-900/50 to-transparent"></div>
                        <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent"></div>

                        <div class="absolute top-7 left-8 z-20 flex items-center gap-2">
                            <span class="bg-somno text-white text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest shadow-lg shadow-somno/40 flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse inline-block"></span>
                                Evento Destacado
                            </span>
                        </div>

                        <div class="relative z-10 flex flex-col justify-end p-8 md:p-14 max-w-2xl">
                            <span class="text-somno-light text-xs font-bold uppercase tracking-widest mb-3">{evento.categoria}</span>
                            <h2 class="text-4xl md:text-6xl font-black text-white leading-tight mb-5 drop-shadow-lg">
                                {evento.titulo}
                            </h2>
                            <div class="flex flex-wrap gap-5 text-white/80 font-medium text-sm mb-8">
                                <span class="flex items-center gap-2">
                                    <i class="far fa-calendar-alt text-somno-light"></i>
                                    {evento.dia} {evento.mes}
                                </span>
                                <span class="flex items-center gap-2">
                                    <i class="far fa-clock text-somno-light"></i>
                                    {evento.hora}
                                </span>
                                <span class="flex items-center gap-2">
                                    <i class="fas fa-map-marker-alt text-somno-light"></i>
                                    {evento.lugar}
                                </span>
                            </div>

                            <span class="inline-flex items-center gap-2 bg-white text-slate-900 px-7 py-3.5 rounded-full font-bold text-sm hover:bg-somno hover:text-white transition-all w-fit shadow-xl shadow-black/20 group-hover:bg-somno group-hover:text-white">
                                Ver todos los detalles
                                <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                            </span>
                        </div>

                        <div class="absolute bottom-7 right-8 z-20 hidden md:block text-right">
                            <span class="text-7xl font-black text-white/10 leading-none select-none">{evento.dia}</span>
                            <span class="block text-somno font-black text-xl tracking-widest -mt-2">{evento.mes}</span>
                        </div>
                    </a>
                ))}
            </div>
        )}

        <div class="max-w-7xl mx-auto px-4 sm:px-6">

            <div class="flex items-center gap-4 mb-10">
                <div class="h-px flex-1 bg-slate-200"></div>
                <span class="flex items-center gap-2 text-sm font-bold text-slate-800 uppercase tracking-widest px-2 whitespace-nowrap">
                    <span class="w-2 h-2 rounded-full bg-somno animate-pulse inline-block"></span>
                    Próximos eventos
                </span>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>

            {proximos.length === 0 ? (
                <div class="text-center py-20 bg-white rounded-3xl border border-slate-100 shadow-sm mb-16">
                    <div class="w-16 h-16 rounded-full bg-somno/10 flex items-center justify-center text-somno text-2xl mx-auto mb-5">
                        <i class="fas fa-moon"></i>
                    </div>
                    <h3 class="text-xl font-black text-slate-700 mb-2">Sin eventos próximos</h3>
                    <p class="text-slate-400 text-sm">Pronto anunciaremos nuevas actividades. ¡Mantente atento!</p>
                </div>
            ) : (
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
                    {proximos.map((evento, i) => (
                        <a
                            href={`/eventos/${evento.slug}`}
                            class="group bg-white rounded-4xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col animate-fade-in-up"
                            style={`animation-delay: ${0.15 + i * 0.07}s`}
                        >
                            <div class="relative h-60 overflow-hidden">
                                <img src={evento.img} alt={evento.titulo} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                <div class="absolute inset-0 bg-slate-900/20 group-hover:bg-slate-900/0 transition-colors duration-300"></div>
                                {evento.destacado && (
                                    <div class="absolute top-4 left-4 bg-yellow-400 text-slate-900 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-lg">★ Destacado</div>
                                )}
                                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-md rounded-2xl px-3.5 py-2.5 text-center shadow-lg min-w-13">
                                    <span class="block text-2xl font-black text-slate-800 leading-none">{evento.dia}</span>
                                    <span class="block text-[10px] font-bold text-somno uppercase tracking-wider mt-0.5">{evento.mes}</span>
                                </div>
                            </div>
                            <div class="p-7 flex flex-col grow">
                                <span class="text-[11px] font-bold text-somno uppercase tracking-widest mb-2">{evento.categoria}</span>
                                <h3 class="text-xl font-black text-slate-800 mb-4 leading-snug group-hover:text-somno transition-colors duration-300">{evento.titulo}</h3>
                                <div class="space-y-2 mb-6 text-sm text-slate-500">
                                    <div class="flex items-center gap-3"><i class="far fa-clock w-4 text-center text-somno"></i>{evento.hora}</div>
                                    <div class="flex items-center gap-3"><i class="fas fa-map-marker-alt w-4 text-center text-somno"></i>{evento.lugar}</div>
                                    <div class="flex items-center gap-3"><i class="fas fa-ticket-alt w-4 text-center text-somno"></i>{evento.precio}</div>
                                </div>
                                <span class="mt-auto w-full py-3 rounded-xl border border-slate-200 text-center font-bold text-slate-600 group-hover:bg-somno group-hover:border-somno group-hover:text-white transition-all duration-300 block">
                                    Ver Detalles →
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            )}
        </div>

        {pasados.length > 0 && (
            <div class="max-w-7xl mx-auto px-4 sm:px-6">

                <div class="flex items-center gap-4 mb-10">
                    <div class="h-px flex-1 bg-slate-200"></div>
                    <span class="flex items-center gap-2 text-sm font-bold text-slate-400 uppercase tracking-widest px-2 whitespace-nowrap">
                        <i class="fas fa-archive text-slate-300 text-xs"></i>
                        Eventos anteriores
                    </span>
                    <div class="h-px flex-1 bg-slate-200"></div>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
                    {pasados.map((evento, i) => (
                        <a href={`/eventos/${evento.slug}`} class="group relative rounded-4xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col h-80 animate-fade-in-up" style={`animation-delay: ${0.1 + i * 0.06}s`}>
                            <img
                                src={evento.img}
                                alt={evento.titulo}
                                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />

                            <div class="absolute inset-0 bg-linear-to-t from-slate-900/90 via-slate-900/30 to-transparent"></div>

                            <div class="absolute top-4 left-4 z-10">
                                <span class="inline-flex items-center gap-1.5 bg-slate-950/25 backdrop-blur-md border border-white/20 text-white text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
                                    <i class="fas fa-images text-somno-light text-[9px]"></i>
                                    Ver memorias
                                </span>
                            </div>

                            <div class="absolute top-4 right-4 z-10 text-right">
                                <span class="block text-3xl font-black text-white/20 leading-none select-none">{evento.dia}</span>
                                <span class="block text-[10px] font-black text-white/50 uppercase tracking-widest -mt-1">{evento.mes}</span>
                            </div>

                            <div class="relative z-10 mt-auto p-6">
                                <span class="text-[10px] font-bold text-somno-light uppercase tracking-widest mb-1 block">{evento.categoria}</span>
                                <h3 class="text-xl font-black text-white leading-snug mb-3">
                                    {evento.titulo}
                                </h3>
                                <div class="flex items-center justify-between">
                                    <span class="flex items-center gap-1.5 text-white/60 text-xs">
                                        <i class="fas fa-map-marker-alt text-somno-light"></i>
                                        {evento.lugar}
                                    </span>
                                    <span class="flex items-center gap-1 text-white font-bold text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                        Ver galería <i class="fas fa-arrow-right text-[10px]"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="absolute inset-0 rounded-4xl ring-2 ring-somno/0 group-hover:ring-somno/60 transition-all duration-300 pointer-events-none"></div>
                        </a>
                    ))}
                </div>
            </div>
        )}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-4">
            <div class="relative rounded-[2.5rem] overflow-hidden bg-slate-900 shadow-2xl shadow-slate-900/30">

                <div class="absolute inset-0 bg-linear-to-br from-somno-dark/30 via-transparent to-somno/20 pointer-events-none"></div>
                <div class="absolute top-0 right-0 w-80 h-80 bg-somno/10 rounded-full blur-[80px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
                <div class="absolute bottom-0 left-0 w-56 h-56 bg-somno-dark/20 rounded-full blur-[60px] translate-y-1/3 -translate-x-1/4 pointer-events-none"></div>

                <div class="relative z-10 flex flex-col md:flex-row items-center gap-10 p-10 md:p-14">

                    <div class="shrink-0 w-20 h-20 rounded-3xl bg-somno/20 border border-somno/30 flex items-center justify-center text-somno text-4xl shadow-lg shadow-somno/10">
                        <i class="fas fa-stethoscope"></i>
                    </div>

                    <div class="flex-1 text-center md:text-left">
                        <span class="text-somno-light font-bold uppercase tracking-[0.2em] text-xs mb-3 block">Después del evento</span>
                        <h2 class="text-2xl md:text-3xl font-black text-white mb-3 leading-tight tracking-tight">
                            ¿Listo para dar el siguiente paso?
                        </h2>
                        <p class="text-slate-400 text-base max-w-lg">
                            Nuestros eventos son solo el inicio. Conoce los servicios clínicos de SomnoLab y transforma tu sueño con acompañamiento especializado.
                        </p>
                    </div>

                    <div class="shrink-0">
                        <a href="/servicios" class="group inline-flex items-center gap-3 bg-somno text-white font-bold px-8 py-4 rounded-2xl hover:bg-somno-dark transition-all shadow-xl shadow-somno/30 hover:shadow-somno/50 hover:-translate-y-0.5 whitespace-nowrap">
                            Ver Servicios
                            <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </main>
</Layout>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        opacity: 0;
        animation: fadeInUp 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
</style>