---

/**
 * @file lista.astro (Seguimiento de hábitos)
 * @description Directorio simplificado (nombre + edad) de pacientes en
 * seguimiento de hábitos de sueño. Incluye modal de alta rápida que,
 * al guardar, redirige al informe de seguimiento del paciente creado.
 */

import Layout from "../../../layouts/Layout.astro"
import Icon from "../../../components/Icon.astro"
import ReturnButton from "../../../components/ReturnButton.astro"
import { createClient } from "@supabase/supabase-js"

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_KEY
);

const user = await Astro.locals.currentUser();
const nombreRegistrador = user
    ? `${user.firstName} ${user.lastName}`.trim() || user.username || "Usuario desconocido"
    : "Anónimo";

let error = "";

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();

        const nuevoPaciente = {
            nombre: data.get("nombre"),
            edad: data.get("edad") ? parseInt(data.get("edad") as string) : null,
            genero: data.get("genero"),
            diagnostico: data.get("diagnostico"),
            registrado_por: nombreRegistrador
        };

        const { data: pacienteInsertado, error: errorInsert } = await supabase
            .from("habitos_pacientes")
            .insert([nuevoPaciente])
            .select()
            .single();

        if (errorInsert) throw errorInsert;

        return Astro.redirect(`/admin/habitos/${pacienteInsertado.id}`);

    } catch (e) {
        console.error(e);
        error = e instanceof Error ? e.message : "Error desconocido al registrar el paciente";
    }
}

const { data: pacientes, error: errorLista } = await supabase
    .from("habitos_pacientes")
    .select("id, nombre, edad, created_at")
    .order("created_at", { ascending: false });

if (errorLista) console.error(errorLista);
---

<Layout title="Seguimiento de hábitos | SomnoLab" showFooter={false}>
    <Icon />
    <ReturnButton href="/admin/dashboard" text="Volver al dashboard" />

    <main class="max-w-4xl mx-auto pt-10 pb-28 px-4">

        <div class="mb-8 text-center">
            <h1 class="text-4xl md:text-5xl font-extrabold text-balance text-center">Seguimiento de <span class="bg-linear-to-r from-somno via-somno-light to-somno-dark bg-clip-text text-transparent">hábitos</span></h1>
            <p class="pt-4 text-lg text-gray-400 text-center">Pacientes registrados para el diario de compromiso de hábitos de sueño.</p>
        </div>

        {error && (
            <div class="mb-6 bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl p-4">
                {error}
            </div>
        )}

        <div class="flex justify-end mb-4">
            <button
                onclick="document.getElementById('modal-nuevo-habito').showModal()"
                class="flex items-center gap-2 bg-somno hover:bg-somno-dark transition-colors text-white text-sm font-bold px-5 py-2.5 rounded-full shadow-sm shadow-somno/20 cursor-pointer"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nuevo paciente
            </button>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-2xl overflow-hidden shadow-sm">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50/50">
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Nombre</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Edad</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {(pacientes || []).map((paciente) => (
                        <tr
                            class="group cursor-pointer hover:bg-somno/3 transition-colors"
                            onclick={`window.location.href='/admin/habitos/${paciente.id}'`}
                        >
                            <td class="px-6 py-4 text-gray-700 font-medium capitalize group-hover:text-gray-900">
                                {paciente.nombre}
                            </td>
                            <td class="px-6 py-4 text-gray-400">
                                {paciente.edad != null ? `${paciente.edad} años` : "—"}
                            </td>
                        </tr>
                    ))}

                    {(!pacientes || pacientes.length === 0) && (
                        <tr>
                            <td colspan="2" class="px-6 py-16 text-center text-gray-400 text-sm">
                                Aún no hay pacientes en seguimiento de hábitos.
                            </td>
                        </tr>
                    )}
                </tbody>
            </table>
        </div>
    </main>

    <dialog id="modal-nuevo-habito" class="m-auto p-0 rounded-2xl max-w-md w-full shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
        <div class="bg-white p-6 w-full">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-bold text-gray-900">Nuevo paciente de hábitos</h3>
                <button type="button" id="btn-cerrar-modal-habito" class="text-gray-400 hover:text-gray-700 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Nombre</label>
                    <input type="text" name="nombre" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-somno/40" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Edad</label>
                        <input type="number" name="edad" min="0" max="120" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-somno/40" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Género</label>
                        <select name="genero" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-somno/40">
                            <option value="">Selecciona</option>
                            <option value="male">Masculino</option>
                            <option value="female">Femenino</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Diagnóstico</label>
                    <textarea name="diagnostico" rows="3" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-somno/40"></textarea>
                </div>

                <button type="submit" class="w-full bg-somno hover:bg-somno-dark text-white font-bold py-3 rounded-xl transition-colors cursor-pointer">
                    Registrar y generar enlace
                </button>
            </form>
        </div>
    </dialog>
</Layout>

<script>
    const modal = document.getElementById('modal-nuevo-habito') as HTMLDialogElement;
    document.getElementById('btn-cerrar-modal-habito')?.addEventListener('click', () => modal.close());
    modal?.addEventListener('click', (e) => {
        const r = modal.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
            modal.close();
        }
    });

    if (document.querySelector('.bg-red-50')) {
        modal?.showModal();
    }
</script>